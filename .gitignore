# Orphaned GNU binutils temp files (ar/objcopy/strip "stXXXXXX", 6 random chars).
# Char classes (not "?") avoid shadowing sources like stdarg.h / strtol.c.
st[0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z]

