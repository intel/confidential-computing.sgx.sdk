# Files generated by autogen.sh / autoreconf --force --install / ./configure in
# this in-tree libunwind copy.
#
# These autotools artifacts are scoped here (instead of the repo-root .gitignore)
# precisely because their names are generic fixed strings -- "missing", "compile",
# "libtool", "config/", etc.


# autoconf/automake/libtool driver, cache and config files (project root)
/configure
/aclocal.m4
/autom4te.cache/
/libtool
/config.log
/config.status

# aux scripts dropped into config/ by automake/libtoolize (whole dir is generated)
/config/

# m4 macros copied in by libtoolize
/m4/libtool.m4
/m4/lt~obsolete.m4
/m4/ltoptions.m4
/m4/ltsugar.m4
/m4/ltversion.m4

# generated Makefiles (committed sources are *.am / *.in) and configure stamps
Makefile
stamp-h1

# top-level docs/headers generated from the committed *.in / *.am
/INSTALL
/include/config.h
/include/config.h.in
/include/libunwind.h
/include/libunwind-common.h
/include/pthread_compat.h
/include/tdep/libunwind_i.h
